# Relay configuration (v1)
#
# The relay reads plain environment variables; it does not load .env by itself.
# Copy the values you need into your shell, systemd unit, Docker environment,
# or use a process manager that supports env files.
#
# PowerShell example:
#   $env:PORT = "8080"
#   $env:RELAY_TOKEN = "change-me"
#   npm start

# HTTP/WebSocket port.
PORT=8080

# Bind address. Use 0.0.0.0 for LAN/VPS, 127.0.0.1 behind a reverse proxy.
HOST=0.0.0.0

# Directory with the built ghost client (index.html + assets).
# Defaults to ../ghost-app/dist relative to the relay sources.
# PUBLIC_DIR=D:\Projects\Hard Multiplayer\ghost-app\dist

# Optional shared secret for the game role. If set, the mod must send the
# same value in its hello message (Relay/Token in the mod config).
# Ghosts do not need this token.
# RELAY_TOKEN=change-me

# How long an empty room (and its cached map/snapshot) is kept, in minutes.
ROOM_TTL_MINUTES=15
